[color]
	ui = true
[core]
	editor = nvim
	fileMode = false
[alias]
	loga = log --oneline --decorate --graph --all
	unstage = reset HEAD --
	conflicts = diff --diff-filter=U
	alias = ! git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /
[init]
	defaultBranch = main
[pull]
	ff = only
[safe]
	directory = *
# Machine-local settings: credential helpers, work hosts, anything gh or Git
# Credential Manager writes on its own. ~/.gitconfig is a symlink into this
# repo, so `git config --global` lands here -- keep such settings in the
# included file to leave the repo clean. Last include wins, so it can also
# override anything above.
[include]
	path = ~/.gitconfig.local
