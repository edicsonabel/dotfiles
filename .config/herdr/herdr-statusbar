#!/usr/bin/env bash
# herdr-statusbar: feeds battery/clock/date/git sidebar tokens to herdr
# workspaces. Colors live in config.toml ([ui.sidebar.spaces] rows, static hex);
# icons are the variables below. No terminal/palette dependency.
# Event-driven: a socket subscription to workspace.focused triggers an instant
# update on space switch; a 30s tick (aligned to the minute) keeps
# clock/battery fresh. Cheap by design: metadata is only reported when it
# changed (every report makes herdr redraw), and git toplevels are cached.
# Run by herdr-statusbar.service (systemd --user); safe to run before the
# herdr server is up — it just retries on the next tick.
set -u

# systemd --user starts this before the login shell imports its environment,
# so herdr (~/.local/bin) may be missing from PATH.
export PATH="$HOME/.local/bin:$PATH"

BAT=/sys/class/power_supply/BAT0
HERDR_SOCK="$HOME/.config/herdr/herdr.sock"
FIFO="${XDG_RUNTIME_DIR:-/tmp}/herdr-statusbar.fifo"
REPOS_SEEN="${XDG_RUNTIME_DIR:-/tmp}/herdr-statusbar.repos"
# Background `git fetch` interval (seconds) so ⇣ (pull needed) stays accurate.
# Set HERDR_STATUSBAR_FETCH=0 in the service environment to disable.
FETCH_INTERVAL="${HERDR_STATUSBAR_FETCH:-900}"

# Nerd Font icons (rendered via Symbols Nerd Font fontconfig fallback).
ICON_BAT_FULL=$''   # battery full
ICON_BAT_HALF=$''   # battery half
ICON_BAT_LOW=$''    # battery quarter
ICON_BOLT=$'󱐋'       # charging
ICON_CLOCK=$''
ICON_CAL=$''
ICON_BRANCH=$''     # powerline git branch (project space = repo directo)
ICON_REPO=$'󰷏'      # nf-md-folder-open-outline: lineas de proyecto en spaces raiz

# "ahead behind" vs upstream for one repo; "0 0" = in sync (or no upstream).
# behind accuracy depends on the last fetch (see fetch_loop).
# Sets AHEAD/BEHIND (globals, so callers need no subshell).
repo_sync_counts() { # $1 = repo toplevel
  local counts
  AHEAD=0 BEHIND=0
  counts=$(git -C "$1" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null) || return 0
  read -r BEHIND AHEAD <<<"$counts"
  AHEAD=${AHEAD:-0} BEHIND=${BEHIND:-0}
}

# Seconds between ticks. Ticks are aligned to this boundary so the clock
# flips with the minute. Override with HERDR_STATUSBAR_TICK in the service.
TICK_INTERVAL="${HERDR_STATUSBAR_TICK:-30}"
[ "$TICK_INTERVAL" -gt 0 ] 2>/dev/null || TICK_INTERVAL=30
# Full resend every N ticks, as a safety net against tokens lost server-side.
RESYNC_TICKS=20
SOCK_STAMP="${XDG_RUNTIME_DIR:-/tmp}/herdr-statusbar.stamp"
TICKS=0

# cwd -> git toplevel ('' = not a repo). Flushed on every resync.
declare -A TOP_CACHE=()
repo_top() { # $1 = cwd; sets TOP
  if [ -z "${TOP_CACHE[$1]+x}" ]; then
    TOP_CACHE[$1]=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)
  fi
  TOP=${TOP_CACHE[$1]}
}

# Last args successfully reported per workspace+group. report-metadata is
# skipped when nothing changed: each call makes herdr redraw every client.
declare -A LAST_SENT=()
report() { # $1 = workspace_id, $2 = group, rest = report-metadata args
  local id=$1 key="$1/$2" sig
  shift 2
  local IFS=$'\x1f'
  sig="$*"
  [ "${LAST_SENT[$key]:-}" = "$sig" ] && return 0
  herdr workspace report-metadata "$id" --source statusbar "$@" >/dev/null 2>&1 \
    && LAST_SENT[$key]=$sig
}

# Per-project sidebar slots (rows defined in config.toml). Each slot is one
# line: git{i}_name (plain) + git{i}_push (green) + git{i}_pull (red).
# Herdr draws a fixed "·" between visible same-row tokens; unavoidable when
# mixing colors, since token values are plain text (no inline ANSI).
MAX_PROJ=4

clear_proj_slots() { # $1 = first slot to clear (1-based)
  local i
  for ((i = $1; i <= MAX_PROJ; i++)); do
    GIT_ARGS+=(--clear-token "git${i}_name" --clear-token "git${i}_push" --clear-token "git${i}_pull")
  done
}

# $git: one token replacing the built-in branch token (which always gets
# herdr's "·" separator before it). Two shapes:
#  - first pane cwd IS a repo  -> "<icon> <branch>" (project space, as before)
#  - first pane cwd is NOT a repo (workspace-root space) -> scan every pane
#    cwd, dedupe by git toplevel, one git{i}_* slot (own sidebar line) per
#    repo needing sync, labeled by the tab that holds the project (dir name
#    as fallback): " Frontend ⇣3".
# Sets GIT_ARGS for report-metadata; appends repo paths to $REPOS_SEEN.tmp
# so fetch_loop knows what to fetch.
set_git_args() { # $1 = workspace_id
  local lines=() p first br
  # This workspace's "cwd<TAB>tab-label" lines, in pane order (PANES is built
  # once per tick, one "workspace_id<TAB>cwd<TAB>tab-label" line per pane).
  for p in "${PANES[@]}"; do
    [ "${p%%$'\t'*}" = "$1" ] && lines+=("${p#*$'\t'}")
  done
  first=''
  [ "${#lines[@]}" -gt 0 ] && first=${lines[0]%%$'\t'*}
  br=''
  [ -n "$first" ] && br=$(git -C "$first" branch --show-current 2>/dev/null)
  if [ -n "$br" ]; then
    GIT_ARGS=(--token "git=$ICON_BRANCH $br")
    clear_proj_slots 1
    repo_top "$first"
    [ -n "$TOP" ] && printf '%s\n' "$TOP" >>"$REPOS_SEEN.tmp"
    return
  fi
  local -A seen=()
  local line cwd label top idx=0
  GIT_ARGS=(--clear-token git)
  for line in "${lines[@]}"; do
    cwd=${line%%$'\t'*}
    label=${line#*$'\t'}
    [ -n "$cwd" ] || continue
    repo_top "$cwd"
    top=$TOP
    [ -n "$top" ] || continue
    [ -n "${seen[$top]:-}" ] && continue
    seen[$top]=1
    printf '%s\n' "$top" >>"$REPOS_SEEN.tmp"
    repo_sync_counts "$top"
    { [ "$AHEAD" -gt 0 ] || [ "$BEHIND" -gt 0 ]; } || continue
    [ "$idx" -ge "$MAX_PROJ" ] && continue
    idx=$((idx + 1))
    GIT_ARGS+=(--token "git${idx}_name=$ICON_REPO ${label:-${top##*/}}")
    if [ "$AHEAD" -gt 0 ]; then GIT_ARGS+=(--token "git${idx}_push=⇡$AHEAD")
    else GIT_ARGS+=(--clear-token "git${idx}_push"); fi
    if [ "$BEHIND" -gt 0 ]; then GIT_ARGS+=(--token "git${idx}_pull=⇣$BEHIND")
    else GIT_ARGS+=(--clear-token "git${idx}_pull"); fi
  done
  clear_proj_slots $((idx + 1))
}

# One full token refresh. Tokens only on the focused workspace so the sidebar
# shows one clock/battery block (tmux-style), not one per space.
tick() {
  local list snap focused='' others=() spaces w f cap status bat_token bat_icon clock date_text id t
  local bat_args
  list=$(herdr workspace list 2>/dev/null)
  snap=$(herdr api snapshot 2>/dev/null)
  [ -n "${list:-}" ] || return 0
  # Server (re)started -> its tokens are gone: forget what was sent. Also a
  # periodic full resend, which picks up directories that became repos.
  if [ "$HERDR_SOCK" -nt "$SOCK_STAMP" ] || [ $((TICKS % RESYNC_TICKS)) -eq 0 ]; then
    LAST_SENT=() TOP_CACHE=()
    : >"$SOCK_STAMP"
  fi
  TICKS=$((TICKS + 1))
  : >"$REPOS_SEEN.tmp"
  mapfile -t spaces < <(jq -r '.result.workspaces[] | [.workspace_id, (.focused | tostring)] | @tsv' <<<"$list" 2>/dev/null)
  for w in "${spaces[@]}"; do
    f=${w#*$'\t'} w=${w%%$'\t'*}
    if [ "$f" = true ]; then focused=$w; else others+=("$w"); fi
  done
  mapfile -t PANES < <(jq -r '
    .result.snapshot as $s
    | ($s.tabs | map({key: .tab_id, value: (.label // "")}) | from_entries) as $labels
    | $s.panes[]
    | [(.pane_id | split(":")[0]), (.cwd // ""), ($labels[.tab_id] // "")]
    | @tsv' <<<"$snap" 2>/dev/null)

  { read -r cap <"$BAT/capacity"; } 2>/dev/null || cap='?'
  { read -r status <"$BAT/status"; } 2>/dev/null || status=''
  # Conditional color via three tokens: only the matching level is reported,
  # the rest are cleared; herdr hides empty tokens. Colors live in config.toml.
  bat_token='bat_ok' bat_icon=$ICON_BAT_FULL
  if [ "$cap" != '?' ]; then
    if [ "$cap" -le 20 ]; then bat_token='bat_low' bat_icon=$ICON_BAT_LOW
    elif [ "$cap" -lt 75 ]; then bat_token='bat_mid' bat_icon=$ICON_BAT_HALF; fi
  fi
  case $status in Charging) bat_token='bat_chg' bat_icon=$ICON_BOLT ;; esac
  printf -v clock '%s %(%I:%M %P)T' "$ICON_CLOCK" -1
  printf -v date_text '%s %(%a %m/%d)T' "$ICON_CAL" -1
  # herdr caps report-metadata at 16 tokens per call -> git slots go separate.
  if [ -n "$focused" ]; then
    set_git_args "$focused"
    bat_args=(--token "$bat_token=${bat_icon} ${cap}%" --token "clock=$clock" --token "date=$date_text")
    for t in bat_low bat_mid bat_ok bat_chg; do
      [ "$t" != "$bat_token" ] && bat_args+=(--clear-token "$t")
    done
    report "$focused" info "${bat_args[@]}"
    report "$focused" git "${GIT_ARGS[@]}"
  fi
  for id in "${others[@]}"; do
    set_git_args "$id"
    report "$id" info \
      --clear-token bat_low --clear-token bat_mid --clear-token bat_ok --clear-token bat_chg \
      --clear-token clock --clear-token date
    report "$id" git "${GIT_ARGS[@]}"
  done
  sort -u "$REPOS_SEEN.tmp" >"$REPOS_SEEN" 2>/dev/null
}

# Periodic fetch of every repo currently visible in some space, so ⇣ (behind
# upstream = pull needed) reflects the remote. Quiet, best-effort, bounded.
fetch_loop() {
  local r
  while true; do
    sleep "$FETCH_INTERVAL"
    [ -s "$REPOS_SEEN" ] || continue
    while IFS= read -r r; do
      timeout 60 git -C "$r" fetch --quiet --no-recurse-submodules >/dev/null 2>&1
    done <"$REPOS_SEEN"
  done
}

# Background subscriber: one line to the FIFO per workspace focus change.
# Reconnects if the herdr server restarts.
focus_events() {
  python3 - "$HERDR_SOCK" <<'PY'
import socket, sys, time
path = sys.argv[1]
req = b'{"id":"sub","method":"events.subscribe","params":{"subscriptions":[{"type":"workspace.focused"}]}}\n'
while True:
    try:
        s = socket.socket(socket.AF_UNIX)
        s.connect(path)
        s.sendall(req)
        for line in s.makefile():
            if '"workspace_focused"' in line:
                print('x', flush=True)
    except Exception:
        pass
    time.sleep(2)
PY
}

rm -f "$FIFO"; mkfifo "$FIFO"
focus_events >"$FIFO" &
FOCUS_PID=$!
FETCH_PID=''
if [ "$FETCH_INTERVAL" -gt 0 ] 2>/dev/null; then
  fetch_loop &
  FETCH_PID=$!
fi
trap 'kill $FOCUS_PID $FETCH_PID 2>/dev/null; rm -f "$FIFO" "$REPOS_SEEN" "$REPOS_SEEN.tmp" "$SOCK_STAMP"' EXIT
exec 3<>"$FIFO"

while true; do
  tick
  # Wake early on a focus event, otherwise sleep to just past the next
  # TICK_INTERVAL boundary (so the clock flips with the minute); drain queued
  # events so rapid switching doesn't backlog.
  printf -v now '%(%s)T' -1
  read -t $((TICK_INTERVAL - now % TICK_INTERVAL + 1)) -r -u 3 _ || true
  while read -t 0.1 -r -u 3 _; do :; done
done
